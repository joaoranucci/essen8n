# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# NUNCA commite o ".env" de verdade - ele fica de fora do Git pelo .gitignore.

# ---- Postgres (banco interno do n8n + tabela de lock do workflow) ----
# Gere uma senha aleatoria, ex.: openssl rand -hex 20
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
POSTGRES_DB=n8n

# ---- n8n ----
# Chave de criptografia das credenciais salvas no n8n. Gere UMA VEZ com:
#   openssl rand -hex 24
# e nunca mude depois de criar credenciais (senao elas ficam ilegiveis).
N8N_ENCRYPTION_KEY=troque-por-uma-chave-hex-aleatoria

# ---- Workflow ENVIO PDF ----
# true = so envia para ENVPDF_TELEFONE_TESTE (protecao adicional ao hardcode
# do proprio workflow de teste). false = necessario so na copia de PRODUCAO.
ENVPDF_MODO_TESTE=true
ENVPDF_TELEFONE_TESTE=5546991359005
ENVPDF_TELEFONE_ALERTA=5546991359005

# Pasta raiz das categorias no Drive (ja informada pelo usuario)
ENVPDF_PASTA_RAIZ_ID=1py_-XOuvDYGNDp0LRDMYtQWQTK5NO41_
# Pasta ENVIADOS (arquivamento pos-envio; excluida da busca de PDFs)
ENVPDF_PASTA_ENVIADOS_ID=1w1OyGbL6pcv6-IRH0Ka2Yg9Y5JJwNcec
# Pasta PRIVADA (so o dono) para copias temporarias compartilhadas por link.
# Crie-a manualmente no Drive e cole o ID aqui - o workflow nao a cria sozinho.
ENVPDF_PASTA_LINKS_ID=

# Planilha geral de clientes
ENVPDF_PLANILHA_ID=1UTXndd5g4N8czVpP1cGJIm_PuNVeyvB2fNimrlBVzBs
ENVPDF_PLANILHA_ABA=Página1

# Limites operacionais
ENVPDF_MAX_PDFS_POR_EXECUCAO=1
ENVPDF_ARQUIVO_TESTE_ID=
ENVPDF_MAX_TENTATIVAS=3
ENVPDF_PAUSA_SEGUNDOS=5
ENVPDF_ENVIO_TRAVADO_MINUTOS=30
